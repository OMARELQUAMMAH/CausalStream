# experiments/coverage_probability.py
# CausalStream: Coverage Probability Analysis
# Section 5.4.2 of the paper
#
# Runs 500 independent simulations to verify that the proposed 95% confidence
# intervals achieve nominal coverage despite the non-IID nature of streaming data.
#
# True ATE = -2.5
# Usage: python experiments/coverage_probability.py

import numpy as np
import matplotlib.pyplot as plt
from collections import deque
from sklearn.linear_model import SGDClassifier, SGDRegressor

# ── Seed ──────────────────────────────────────────────────────
np.random.seed(42)

# ── Data generation (Section 5.4.1) ───────────────────────────
def generate_data(n, tau=-2.5):
    X = np.random.normal(0, 1, n)
    propensity = 1.0 / (1.0 + np.exp(-(-0.5 + 0.5 * X)))
    T = np.random.binomial(1, propensity, n)
    eps = np.random.normal(0, 2, n)
    Y = 10 + 2 * X + tau * T + eps
    return X.reshape(-1, 1), T, Y, propensity


# ── Welford variance ───────────────────────────────────────────
class WelfordVariance:
    def __init__(self):
        self.n = 0; self.mean = 0.0; self.M2 = 0.0

    def update(self, x):
        self.n += 1
        delta = x - self.mean
        self.mean += delta / self.n
        self.M2 += delta * (x - self.mean)

    def std(self):
        return np.sqrt(self.M2 / (self.n - 1)) if self.n > 1 else 0.0


# ── CausalStream (streaming) ───────────────────────────────────
def run_causalstream(X, T, Y):
    """Run CausalStream on a single simulation, return ATE history and CI history."""
    n = len(T)
    prop_model = SGDClassifier(loss='log_loss', learning_rate='invscaling',
                               eta0=0.01, power_t=1.0, random_state=42)
    out_models = {
        0: SGDRegressor(learning_rate='invscaling', eta0=0.01, power_t=1.0, random_state=42),
        1: SGDRegressor(learning_rate='invscaling', eta0=0.01, power_t=1.0, random_state=42)
    }
    classes = np.array([0, 1])
    tau_hat = 0.0
    welford = WelfordVariance()
    n_seen = {0: 0, 1: 0}
    prop_n = 0
    eps = 1e-8
    ci_history = []

    for i in range(n):
        x = X[i].reshape(1, -1)
        t = int(T[i])
        y = Y[i]

        # Propensity
        if prop_n == 0:
            prop_model.partial_fit(x, [t], classes=classes)
        else:
            prop_model.partial_fit(x, [t])
        prop_n += 1
        pi = np.clip(prop_model.predict_proba(x)[0][1], eps, 1 - eps)

        # Outcome
        out_models[t].partial_fit(x, [y])
        n_seen[t] += 1
        mu0 = out_models[0].predict(x)[0] if n_seen[0] > 0 else y
        mu1 = out_models[1].predict(x)[0] if n_seen[1] > 0 else y

        # Influence function and DR update
        psi = T[i] * (y - mu1) / pi - (1 - T[i]) * (y - mu0) / (1 - pi) + mu1 - mu0
        tau_hat += (psi - tau_hat) / (i + 1)
        welford.update(psi)

        # CI at checkpoints
        if (i + 1) in [100, 500, 1000, 2000, 3000, 4000, 5000]:
            se = welford.std() / np.sqrt(i + 1) if i > 0 else float('inf')
            ci_history.append({
                'n': i + 1,
                'tau_hat': tau_hat,
                'ci_lower': tau_hat - 1.96 * se,
                'ci_upper': tau_hat + 1.96 * se
            })

    return ci_history


# ── Main experiment ────────────────────────────────────────────
def main():
    N_SIM   = 500
    N_OBS   = 5000
    TRUE_ATE = -2.5
    CHECKPOINTS = [100, 500, 1000, 2000, 3000, 4000, 5000]

    print("Coverage Probability Analysis")
    print("=" * 50)
    print(f"Simulations : {N_SIM}")
    print(f"Observations: {N_OBS} per simulation")
    print(f"True ATE    : {TRUE_ATE}")
    print()

    # Collect coverage at each checkpoint
    covered = {n: 0 for n in CHECKPOINTS}
    total   = {n: 0 for n in CHECKPOINTS}

    for sim in range(N_SIM):
        if (sim + 1) % 50 == 0:
            print(f"  Running simulation {sim + 1}/{N_SIM}...")
        X, T, Y, _ = generate_data(N_OBS, tau=TRUE_ATE)
        ci_history = run_causalstream(X, T, Y)
        for entry in ci_history:
            n = entry['n']
            if entry['ci_lower'] <= TRUE_ATE <= entry['ci_upper']:
                covered[n] += 1
            total[n] += 1

    print()
    print("Results")
    print("=" * 50)
    print(f"{'n':>6}  {'Coverage':>10}  {'95% CI':>22}")
    print("-" * 42)

    coverages = {}
    for n in CHECKPOINTS:
        cov = covered[n] / total[n]
        # Wilson CI for the coverage proportion
        p = cov
        z = 1.96
        se_p = np.sqrt(p * (1 - p) / total[n])
        ci_lo = p - z * se_p
        ci_hi = p + z * se_p
        coverages[n] = cov
        print(f"{n:>6}  {cov:>10.3f}  ({ci_lo:.3f}, {ci_hi:.3f})")

    # Plot
    ns = list(CHECKPOINTS)
    covs = [coverages[n] for n in ns]

    plt.figure(figsize=(8, 5))
    plt.plot(ns, covs, 'bo-', linewidth=2, markersize=8, label='Empirical coverage')
    plt.axhline(0.95, color='red', linestyle='--', linewidth=1.5, label='Nominal 95%')
    plt.axhline(0.90, color='gray', linestyle=':', linewidth=1, alpha=0.5)
    plt.axhline(1.00, color='gray', linestyle=':', linewidth=1, alpha=0.5)
    plt.ylim(0.85, 1.02)
    plt.xlabel('Sample size (n)', fontsize=12)
    plt.ylabel('Coverage probability', fontsize=12)
    plt.title('Coverage Probability Analysis\n'
              f'({N_SIM} simulations, True ATE = {TRUE_ATE})', fontsize=12)
    plt.legend(fontsize=11)
    plt.tight_layout()
    plt.savefig('coverage_probability.png', dpi=150, bbox_inches='tight')
    print("\nFigure saved to coverage_probability.png")


if __name__ == '__main__':
    main()
